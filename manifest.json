{
  "manifest_version": 3,
  "name": "FilteredResearch",
  "short_name": "FilteredResearch",
  "version": "0.3.0",
  "description": "Build a local, field-filtered research index ranked by novelty and authorship signals.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "alarms",
    "sidePanel",
    "storage"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://api.openalex.org/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open FilteredResearch",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/*"
      ],
      "js": [
        "src/content/arxiv.js"
      ],
      "css": [
        "src/content/arxiv.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://www.semanticscholar.org/*",
        "https://openalex.org/*",
        "https://scholar.google.com/*",
        "https://doi.org/*",
        "https://www.doi.org/*"
      ],
      "js": [
        "src/content/research-sites.js"
      ],
      "css": [
        "src/content/research-sites.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
