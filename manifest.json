{
  "manifest_version": 3,
  "name": "FilteredResearch",
  "short_name": "FilteredResearch",
  "version": "0.7.0",
  "description": "Build a local, field-filtered research index ranked by novelty and authorship signals.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://api.openalex.org/*",
    "https://arxiv.org/*",
    "https://export.arxiv.org/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open FilteredResearch",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/*"
      ],
      "js": [
        "src/content/arxiv.js"
      ],
      "css": [
        "src/content/arxiv.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://www.semanticscholar.org/*",
        "https://openalex.org/*",
        "https://scholar.google.com/*",
        "https://doi.org/*",
        "https://www.doi.org/*",
        "https://www.nature.com/*",
        "https://www.science.org/*",
        "https://www.sciencedirect.com/*",
        "https://link.springer.com/*",
        "https://onlinelibrary.wiley.com/*",
        "https://dl.acm.org/*",
        "https://ieeexplore.ieee.org/*",
        "https://journals.plos.org/*",
        "https://www.mdpi.com/*",
        "https://www.frontiersin.org/*",
        "https://www.tandfonline.com/*",
        "https://journals.sagepub.com/*",
        "https://www.cell.com/*",
        "https://www.pnas.org/*",
        "https://www.biorxiv.org/*",
        "https://www.medrxiv.org/*",
        "https://www.researchsquare.com/*",
        "https://openreview.net/*",
        "https://papers.ssrn.com/*",
        "https://osf.io/*",
        "https://europepmc.org/*",
        "https://core.ac.uk/*",
        "https://dblp.org/*",
        "https://huggingface.co/papers*",
        "https://paperswithcode.com/*",
        "https://www.jstor.org/*",
        "https://academic.oup.com/*",
        "https://iopscience.iop.org/*",
        "https://pubs.acs.org/*",
        "https://www.embopress.org/*",
        "https://elifesciences.org/*",
        "https://www.ncbi.nlm.nih.gov/pmc/*"
      ],
      "js": [
        "src/content/research-sites.js"
      ],
      "css": [
        "src/content/research-sites.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
